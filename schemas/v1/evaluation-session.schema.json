{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "trackerKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "kind": {
      "type": "string",
      "enum": ["stage", "final"]
    },
    "triggerDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "targetDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "planningTimeZone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "calculationVersion": {
      "type": "string",
      "const": "evaluation-evidence-v1"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "evidenceRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        },
        "through": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": ["from", "through"],
      "additionalProperties": false
    },
    "basePlanVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": ["id", "version", "effectiveFrom"],
      "additionalProperties": false
    },
    "timelineHeadPlanVersion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "version": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "effectiveFrom": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
        }
      },
      "required": ["id", "version", "effectiveFrom"],
      "additionalProperties": false
    },
    "effectiveness": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "needs_policy"
        },
        "policyVersion": {
          "type": "null"
        }
      },
      "required": ["status", "policyVersion"],
      "additionalProperties": false
    },
    "weeks": {
      "maxItems": 520,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "weekStart": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "weekEnd": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "tasks": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "completed": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "skipped": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "planned": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": ["total", "completed", "skipped", "planned"],
            "additionalProperties": false
          },
          "feedback": {
            "type": "object",
            "properties": {
              "feedbackDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "expectedDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "maxPain": {
                "anyOf": [
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 10
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "worstSafetyLevel": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": ["green", "yellow", "red"]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "feedbackDays",
              "expectedDays",
              "maxPain",
              "worstSafetyLevel"
            ],
            "additionalProperties": false
          },
          "execution": {
            "type": "object",
            "properties": {
              "pauseDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "travelDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "equipmentLimitedDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "degradedDays": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              }
            },
            "required": [
              "pauseDays",
              "travelDays",
              "equipmentLimitedDays",
              "degradedDays"
            ],
            "additionalProperties": false
          },
          "loadCoverage": {
            "type": "object",
            "properties": {
              "completedTasks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "durationCoveredTasks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "distanceCoveredTasks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sourceCoveredTasks": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "completedTasks",
              "durationCoveredTasks",
              "distanceCoveredTasks",
              "sourceCoveredTasks"
            ],
            "additionalProperties": false
          },
          "effectiveness": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "const": "needs_policy"
              },
              "policyVersion": {
                "type": "null"
              }
            },
            "required": ["status", "policyVersion"],
            "additionalProperties": false
          }
        },
        "required": [
          "weekStart",
          "weekEnd",
          "tasks",
          "feedback",
          "execution",
          "loadCoverage",
          "effectiveness"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "trackerKey",
    "kind",
    "triggerDate",
    "targetDate",
    "planningTimeZone",
    "calculationVersion",
    "createdAt",
    "evidenceRange",
    "basePlanVersion",
    "timelineHeadPlanVersion",
    "effectiveness",
    "weeks"
  ],
  "additionalProperties": false
}
